<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="24.0.0" type="device">
  <diagram id="lab3_v14" name="ЛР3 вариант 14 — табуляция и сумма">
    <mxGraphModel dx="1100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- НАЧАЛО -->
        <mxCell id="start" value="Начало" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="375" y="20" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- ВВОД -->
        <mxCell id="input" value="Ввод x_start, x_end, step" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="110" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- ИНИЦИАЛИЗАЦИЯ -->
        <mxCell id="init" value="n = round((x_end − x_start)/step) + 1&amp;#xa;sum = 0, i = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="200" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- УСЛОВИЕ ЦИКЛА -->
        <mxCell id="loop" value="i &amp;lt; n?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="300" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- ТЕЛО ЦИКЛА: вычисление x -->
        <mxCell id="calc_x" value="x = x_start + i · step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="450" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- УСЛОВИЕ 1 -->
        <mxCell id="cond1" value="x &amp;lt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="540" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- ВЕТВЬ 1 -->
        <mxCell id="y1" value="y = x² − 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- УСЛОВИЕ 2 -->
        <mxCell id="cond2" value="x &amp;lt; 1.5?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="690" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- ВЕТВЬ 2 -->
        <mxCell id="y2" value="y = cos x" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="705" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ВЕТВЬ 3 -->
        <mxCell id="y3" value="y = sin(x − 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="705" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ВЫВОД СТРОКИ -->
        <mxCell id="print_row" value="Вывод: x, y" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="325" y="840" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- ПРОВЕРКА y > 0 -->
        <mxCell id="cond3" value="y &amp;gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="930" width="160" height="100" as="geometry"/>
        </mxCell>

        <!-- НАКОПЛЕНИЕ СУММЫ -->
        <mxCell id="add_sum" value="sum = sum + y" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="955" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ИНКРЕМЕНТ -->
        <mxCell id="incr" value="i = i + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="1080" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ВЫВОД СУММЫ -->
        <mxCell id="print_sum" value="Вывод: sum" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- КОНЕЦ -->
        <mxCell id="end" value="Конец" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="630" y="470" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- СВЯЗИ -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="start" target="input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="input" target="init"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="init" target="loop"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e4" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" edge="1" parent="1" source="loop" target="calc_x"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="loop" target="print_sum"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="calc_x" target="cond1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e7" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="cond1" target="y1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" edge="1" parent="1" source="cond1" target="cond2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e9" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="cond2" target="y2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cond2" target="y3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="y1" target="print_row">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="865"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="y2" target="print_row">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="865"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="y3" target="print_row">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="865"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="print_row" target="cond3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e15" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="cond3" target="add_sum"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" edge="1" parent="1" source="cond3" target="incr"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="add_sum" target="incr">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="1105"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="incr" target="loop">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="1105"/><mxPoint x="620" y="350"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;" edge="1" parent="1" source="print_sum" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>